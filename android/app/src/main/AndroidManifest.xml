<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 访问 Mac 上的 dsh web：HTTP + WebSocket，同一权限 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 扫二维码填地址。声明为「非必需」，没相机的设备照样能装（手输地址）。 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!--
      语音输入用。SpeechRecognizer 需要它 —— 原来走系统识别界面时不需要，
      但那条路在 ColorOS 上走不通（没有 Activity 处理 RECOGNIZE_SPEECH），
      改成直接用识别服务 API 后就必须有了。
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 13+ 发系统通知要运行时授权 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 保活：后台也要能收到「会话跑完了」，否则进程被冻结就收不到 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- API < 29 下载到公共 Downloads 目录才需要；29+ 走 MediaStore 免权限 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    
    <!--
      Android 11 起必须声明才能"看见"别的应用。
      不声明的话 resolveActivity() 一律返回 null —— 表现为"明明有语音识别，
      App 却说这台设备没有"。同理也会影响扫码、打开浏览器这些跳转的判定。

      注意：只声明我们真的要跳过去的那几个 action，不做宽泛匹配。
    -->
    <queries>
        <!-- 语音输入 -->
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <!-- 打开下载页 / 系统设置 -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

<application
        android:name=".DshApp"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

            <!-- 从别的应用分享进来：图片暂存，等用户在 DSH 里点附件时直接交出去。
                 文字不用另加过滤器 —— 下面已经有一个 text/plain 的。 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 在别处（微信/备忘录/设置页）复制的 pocket 链接，直接「分享到 DSH」即可填地址 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <service
            android:name=".WatchService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    
        <!-- 审批通知的两个动作按钮。用广播而不是 Activity：点「允许」不该把
             App 拉到前台 —— 用户的意图只是让 agent 继续跑。 -->
        <receiver
            android:name=".notify.ApprovalReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.dshgo.app.APPROVE" />
                <action android:name="com.dshgo.app.REJECT" />
            </intent-filter>
        </receiver>

        <!-- 主屏小组件：一眼看状态 + 两个动作 -->
        <receiver
            android:name=".notify.DshWidgetProvider"
            android:exported="false"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>
</application>

</manifest>
