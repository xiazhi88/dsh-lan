<?xml version="1.0" encoding="utf-8"?>
<!--
  主屏小组件：一眼看状态，两个动作。

  大部分时候用户只想扫一眼"跑完没有"，不想开 App —— 这就是小组件存在的理由。
  两个按钮复用长按图标的快捷方式 action，逻辑只有一份。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_bg">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_idle"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_detail"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="@string/widget_hint"
        android:textColor="#B0FFFFFF"
        android:textSize="11sp"
        android:maxLines="2"
        android:ellipsize="end"
        android:layout_marginTop="2dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <TextView
            android:id="@+id/widget_new"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/shortcut_new"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:background="@drawable/widget_btn" />

        <TextView
            android:id="@+id/widget_recent"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/shortcut_recent"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_btn" />
    </LinearLayout>
</LinearLayout>
