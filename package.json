{
  "name": "@xiazhi88/dshgo",
  "version": "2.0.2",
  "description": "把只监听 127.0.0.1 的 dsh web 暴露到局域网，并带上移动端适配 —— 一个包，手机连上就能用。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./client": {
      "default": "./client/client.js"
    }
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2",
    "qrcode": "^1.5.4"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "deepseek",
    "mobile",
    "lan",
    "proxy"
  ],
  "author": "xiazhi88",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiazhi88/dshgo.git"
  },
  "homepage": "https://github.com/xiazhi88/dshgo#readme",
  "bugs": {
    "url": "https://github.com/xiazhi88/dshgo/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "dshgo": {
    "appVersion": "4.2.3",
    "appApk": "https://cdn.jsdelivr.net/gh/xiazhi88/dshgo@dist-v4.2.3/dshgo-app.apk",
    "appApkFallback": "https://github.com/xiazhi88/dshgo/releases/latest/download/dshgo-app.apk"
  }
}
